// Skema database Aplikasi Management Pasir Silika (lihat PRD bagian 8).
// Prinsip: stock_ledger append-only, stock_balances = cache saldo,
// semua tonase DECIMAL(14,3), semua waktu disimpan dalam UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== Master =====

enum LocationType {
  tambang
  pabrik
  gudang
  stockpile
}

model Location {
  id        Int          @id @default(autoincrement()) @db.UnsignedInt
  code      String       @unique @db.VarChar(10)
  name      String       @db.VarChar(100)
  type      LocationType
  address   String?      @db.VarChar(255)
  timezone  String       @default("Asia/Jakarta") @db.VarChar(40)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  userLocations    UserLocation[]
  balances         StockBalance[]
  minLevels        StockMinLevel[]
  transactions     Transaction[]   @relation("TrxLocation")
  destTransactions Transaction[]   @relation("TrxDestLocation")
  opnames          StockOpname[]

  @@map("locations")
}

enum Role {
  owner
  admin
  operator
  viewer
}

model User {
  id               Int       @id @default(autoincrement()) @db.UnsignedInt
  name             String    @db.VarChar(100)
  username         String    @unique @db.VarChar(50)
  email            String?   @unique @db.VarChar(120)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  role             Role
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count") @db.UnsignedSmallInt
  lockedUntil      DateTime? @map("locked_until") @db.DateTime(0)
  lastLoginAt      DateTime? @map("last_login_at") @db.DateTime(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  locations     UserLocation[]
  refreshTokens RefreshToken[]
  devices       Device[]
  transactions  Transaction[]  @relation("TrxCreatedBy")
  voided        Transaction[]  @relation("TrxVoidedBy")

  @@map("users")
}

model UserLocation {
  userId     Int      @map("user_id") @db.UnsignedInt
  locationId Int      @map("location_id") @db.UnsignedInt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id])

  @@id([userId, locationId])
  @@map("user_locations")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    Int       @map("user_id") @db.UnsignedInt
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  deviceId  String?   @map("device_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ProductCategory {
  raw
  finished
  byproduct
}

/// Satuan stok produk. Pasir mesh dalam ton; bahan baku mentah dalam rit (1 rit = 1 truk, tanpa tonase).
/// Untuk produk `rit`, kolom qty_ton di item/ledger/saldo berisi jumlah rit.
enum StockUnit {
  ton
  rit
}

model Product {
  id           Int             @id @default(autoincrement()) @db.UnsignedInt
  code         String          @unique @db.VarChar(20)
  name         String          @db.VarChar(100)
  meshSize     String?         @map("mesh_size") @db.VarChar(20)
  category     ProductCategory
  unit         StockUnit       @default(ton)
  densityTonM3 Decimal?        @default(1.600) @map("density_ton_m3") @db.Decimal(6, 3)
  sortOrder    Int             @default(0) @map("sort_order") @db.SmallInt
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  balances    StockBalance[]
  minLevels   StockMinLevel[]
  items       TransactionItem[]
  opnameItems StockOpnameItem[]

  @@map("products")
}

model PackagingUnit {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  name       String   @db.VarChar(50)
  tonPerUnit Decimal  @map("ton_per_unit") @db.Decimal(10, 3)
  isBulk     Boolean  @default(false) @map("is_bulk")
  isActive   Boolean  @default(true) @map("is_active")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  items TransactionItem[]

  @@map("packaging_units")
}

enum PartnerType {
  customer
  supplier
  both
}

model Partner {
  id        Int         @id @default(autoincrement()) @db.UnsignedInt
  type      PartnerType
  name      String      @db.VarChar(150)
  phone     String?     @db.VarChar(30)
  address   String?     @db.VarChar(255)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  transactions Transaction[]

  @@map("partners")
}

model Vehicle {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  plateNumber     String   @unique @map("plate_number") @db.VarChar(15)
  defaultDriver   String?  @map("default_driver") @db.VarChar(100)
  standardTareTon Decimal? @map("standard_tare_ton") @db.Decimal(10, 3)
  isActive        Boolean  @default(true) @map("is_active")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  transactions Transaction[]

  @@map("vehicles")
}

model StockMinLevel {
  locationId Int      @map("location_id") @db.UnsignedInt
  productId  Int      @map("product_id") @db.UnsignedInt
  minTon     Decimal  @default(0) @map("min_ton") @db.Decimal(14, 3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  location   Location @relation(fields: [locationId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@id([locationId, productId])
  @@map("stock_min_levels")
}

// ===== Transaksi =====

enum TrxType {
  IN_RAW
  IN_PRODUCTION
  IN_SUPPLIER
  OUT_SALE
  ADJUSTMENT
  PRODUCTION
  TRANSFER_OUT
  TRANSFER_IN
  SHRINKAGE
  VOID
}

enum TrxStatus {
  posted
  in_transit
  void
  pending_approval
}

model Transaction {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  clientUuid        String    @unique @map("client_uuid") @db.Char(36)
  docNo             String?   @unique @map("doc_no") @db.VarChar(40)
  manualDocNo       String?   @map("manual_doc_no") @db.VarChar(40)
  trxType           TrxType   @map("trx_type")
  locationId        Int       @map("location_id") @db.UnsignedInt
  destLocationId    Int?      @map("dest_location_id") @db.UnsignedInt
  refTransactionId  BigInt?   @map("ref_transaction_id") @db.UnsignedBigInt
  partnerId         Int?      @map("partner_id") @db.UnsignedInt
  partnerName       String?   @map("partner_name") @db.VarChar(150) // snapshot untuk surat jalan
  vehicleId         Int?      @map("vehicle_id") @db.UnsignedInt
  plateNumber       String?   @map("plate_number") @db.VarChar(15)
  driverName        String?   @map("driver_name") @db.VarChar(100)
  grossTon          Decimal?  @map("gross_ton") @db.Decimal(14, 3)
  tareTon           Decimal?  @map("tare_ton") @db.Decimal(14, 3)
  netTon            Decimal?  @map("net_ton") @db.Decimal(14, 3)
  trxAt             DateTime  @map("trx_at") @db.DateTime(0)
  status            TrxStatus @default(posted)
  isLocked          Boolean   @default(false) @map("is_locked")
  notes             String?   @db.VarChar(500)
  photoPath         String?   @map("photo_path") @db.VarChar(255)
  voidReason        String?   @map("void_reason") @db.VarChar(255)
  voidRequestedBy   Int?      @map("void_requested_by") @db.UnsignedInt
  voidRequestedAt   DateTime? @map("void_requested_at") @db.DateTime(0)
  voidRequestReason String?   @map("void_request_reason") @db.VarChar(255)
  reviewNote        String?   @map("review_note") @db.VarChar(255)
  verifyToken       String    @unique @map("verify_token") @db.Char(32)
  printCount        Int       @default(0) @map("print_count") @db.UnsignedSmallInt
  createdById       Int       @map("created_by") @db.UnsignedInt
  voidedById        Int?      @map("voided_by") @db.UnsignedInt
  deviceId          String?   @map("device_id") @db.VarChar(64)
  clientCreatedAt   DateTime  @map("client_created_at") @db.DateTime(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  location     Location          @relation("TrxLocation", fields: [locationId], references: [id])
  destLocation Location?         @relation("TrxDestLocation", fields: [destLocationId], references: [id])
  partner      Partner?          @relation(fields: [partnerId], references: [id])
  vehicle      Vehicle?          @relation(fields: [vehicleId], references: [id])
  createdBy    User              @relation("TrxCreatedBy", fields: [createdById], references: [id])
  voidedBy     User?             @relation("TrxVoidedBy", fields: [voidedById], references: [id])
  refTrx       Transaction?      @relation("TrxRef", fields: [refTransactionId], references: [id])
  referencedBy Transaction[]     @relation("TrxRef")
  items        TransactionItem[]
  ledger       StockLedger[]

  @@index([locationId, trxAt], map: "idx_trx_loc_date")
  @@index([trxType, trxAt], map: "idx_trx_type_date")
  @@index([plateNumber, trxAt], map: "idx_trx_plate")
  @@map("transactions")
}

enum LineRole {
  main
  input
  output
  loss
}

enum Direction {
  in
  out
}

model TransactionItem {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  transactionId   BigInt         @map("transaction_id") @db.UnsignedBigInt
  productId       Int?           @map("product_id") @db.UnsignedInt
  lineRole        LineRole       @default(main) @map("line_role")
  direction       Direction
  packagingUnitId Int?           @map("packaging_unit_id") @db.UnsignedInt
  packageQty      Decimal?       @map("package_qty") @db.Decimal(12, 2)
  qtyTon          Decimal        @map("qty_ton") @db.Decimal(14, 3) // selalu positif
  supersededAt    DateTime?      @map("superseded_at") @db.DateTime(0) // diisi saat transaksi diedit
  transaction     Transaction    @relation(fields: [transactionId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id])
  packagingUnit   PackagingUnit? @relation(fields: [packagingUnitId], references: [id])
  ledger          StockLedger[]

  @@map("transaction_items")
}

// ===== Ledger & saldo =====

model StockLedger {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  transactionId   BigInt          @map("transaction_id") @db.UnsignedBigInt
  itemId          BigInt          @map("item_id") @db.UnsignedBigInt
  locationId      Int             @map("location_id") @db.UnsignedInt
  productId       Int             @map("product_id") @db.UnsignedInt
  qtyChangeTon    Decimal         @map("qty_change_ton") @db.Decimal(14, 3)
  balanceAfterTon Decimal         @map("balance_after_ton") @db.Decimal(14, 3)
  postedAt        DateTime        @default(now()) @map("posted_at") @db.DateTime(0)
  transaction     Transaction     @relation(fields: [transactionId], references: [id])
  item            TransactionItem @relation(fields: [itemId], references: [id])

  @@index([locationId, productId, postedAt], map: "idx_ledger_loc_prod_date")
  @@map("stock_ledger")
}

model StockBalance {
  locationId   Int      @map("location_id") @db.UnsignedInt
  productId    Int      @map("product_id") @db.UnsignedInt
  qtyTon       Decimal  @default(0) @map("qty_ton") @db.Decimal(14, 3)
  inTransitTon Decimal  @default(0) @map("in_transit_ton") @db.Decimal(14, 3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  location     Location @relation(fields: [locationId], references: [id])
  product      Product  @relation(fields: [productId], references: [id])

  @@id([locationId, productId])
  @@map("stock_balances")
}

// ===== Stock opname (Fase 2 — tabel disiapkan) =====

enum OpnameStatus {
  draft
  submitted
  approved
  rejected
}

enum ShrinkReason {
  susut_angin
  hujan_erosi
  kadar_air
  kesalahan_timbang
  lainnya
}

model StockOpname {
  id                  BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  docNo               String            @unique @map("doc_no") @db.VarChar(40)
  locationId          Int               @map("location_id") @db.UnsignedInt
  opnameAt            DateTime          @map("opname_at") @db.DateTime(0)
  status              OpnameStatus      @default(draft)
  createdById         Int               @map("created_by") @db.UnsignedInt
  approvedById        Int?              @map("approved_by") @db.UnsignedInt
  approvedAt          DateTime?         @map("approved_at") @db.DateTime(0)
  resultTransactionId BigInt?           @map("result_transaction_id") @db.UnsignedBigInt
  notes               String?           @db.VarChar(500)
  location            Location          @relation(fields: [locationId], references: [id])
  items               StockOpnameItem[]

  @@map("stock_opnames")
}

model StockOpnameItem {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  opnameId    BigInt        @map("opname_id") @db.UnsignedBigInt
  productId   Int           @map("product_id") @db.UnsignedInt
  systemTon   Decimal       @map("system_ton") @db.Decimal(14, 3)
  physicalTon Decimal       @map("physical_ton") @db.Decimal(14, 3)
  diffTon     Decimal       @map("diff_ton") @db.Decimal(14, 3)
  reason      ShrinkReason?
  volumeM3    Decimal?      @map("volume_m3") @db.Decimal(12, 3)
  opname      StockOpname   @relation(fields: [opnameId], references: [id])
  product     Product       @relation(fields: [productId], references: [id])

  @@map("stock_opname_items")
}

// ===== Pendukung =====

model DocSequence {
  prefix     String @db.VarChar(5)
  locationId Int    @map("location_id") @db.UnsignedInt
  period     String @db.Char(6)
  lastNo     Int    @default(0) @map("last_no") @db.UnsignedInt

  @@id([prefix, locationId, period])
  @@map("doc_sequences")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId    Int?     @map("user_id") @db.UnsignedInt
  action    String   @db.VarChar(40)
  entity    String   @db.VarChar(40)
  entityId  BigInt?  @map("entity_id") @db.UnsignedBigInt
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  deviceId  String?  @map("device_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([userId, createdAt], map: "idx_audit_user_date")
  @@map("audit_logs")
}

model Device {
  id         String    @id @db.VarChar(64)
  userId     Int       @map("user_id") @db.UnsignedInt
  fcmToken   String?   @map("fcm_token") @db.VarChar(255)
  appVersion String?   @map("app_version") @db.VarChar(20)
  lastSyncAt DateTime? @map("last_sync_at") @db.DateTime(0)
  user       User      @relation(fields: [userId], references: [id])

  @@map("devices")
}

model AppSetting {
  key       String   @id @map("setting_key") @db.VarChar(60)
  value     String?  @map("setting_value") @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  @@map("app_settings")
}
