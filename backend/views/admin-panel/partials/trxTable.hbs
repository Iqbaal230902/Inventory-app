{{#if rows.length}}
<div class="tbl-wrap"><table>
  <tr><th>Tanggal</th><th>No. Dokumen</th><th>Jenis</th><th>Lokasi</th><th>Pelanggan / Supplier</th><th>No. Polisi</th><th>Produk</th><th class="n">Ton</th><th>Status</th><th>Oleh</th></tr>
  {{#each rows}}
  <tr class="{{#if (eq status "void")}}dim{{/if}}">
    <td class="nw">{{dt trx_at location.timezone}}</td>
    <td><a href="{{../base}}/trx/{{id}}">{{#if doc_no}}{{doc_no}}{{else}}#{{id}}{{/if}}</a>{{#if manual_doc_no}}<br><small class="muted">{{manual_doc_no}}</small>{{/if}}</td>
    <td class="nw">{{trxTypeLabel trx_type}}</td>
    <td class="nw">{{location.name}}</td>
    <td>{{partner_name}}</td>
    <td style="white-space:nowrap">{{plate_number}}</td>
    <td class="prod">{{#each items}}{{product_name}}{{#unless @last}}, {{/unless}}{{/each}}</td>
    <td class="n">{{ton total_ton}}</td>
    <td><span class="badge {{status}}">{{statusLabel status}}</span>{{#if void_requested}} <span class="badge warning">ajuan void</span>{{/if}}</td>
    <td class="nw">{{created_by.name}}</td>
  </tr>
  {{/each}}
</table></div>
{{else}}
<div class="empty">Belum ada transaksi.</div>
{{/if}}
